{
  "name": "ai-architect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI System Architect — bản web cá nhân (HTML/CSS/JS ES Modules + proxy Node.js)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-reporter=spec \"tests/*.test.js\"",
    "check": "node --check server/index.js && node --check server/providers.js",
    "worker:prepare": "cp docs/LIMITATIONS.md public/docs-LIMITATIONS.md",
    "worker:deploy": "npm run worker:prepare && cd worker && npx wrangler deploy",
    "e2e": "python3 tests/e2e/smoke.py && python3 tests/e2e/pipeline.py"
  }
}