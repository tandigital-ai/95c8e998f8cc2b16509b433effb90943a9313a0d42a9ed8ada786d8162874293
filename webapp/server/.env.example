# ==== AI System Architect — cấu hình proxy (sao chép thành server/.env) ====
# File .env KHÔNG được commit lên git.

# Mạng: mặc định chỉ máy này truy cập được. Đổi thành 0.0.0.0 để dùng từ điện thoại
# trong cùng mạng Wi-Fi — khi đó BẮT BUỘC đặt ACCESS_TOKEN.
HOST=127.0.0.1
PORT=3000

# Mật khẩu truy cập proxy (tùy chọn khi HOST=127.0.0.1). Nhập giống hệt trong app > Cài đặt.
ACCESS_TOKEN=

# API key phía server (tùy chọn). Nhiều key cách nhau bằng dấu phẩy => tự xoay vòng.
# Nếu để trống, bạn có thể nhập key trong trình duyệt (vault mã hóa).
KEY_GEMINI=
KEY_OPENROUTER=
KEY_MISTRAL=
KEY_DEEPSEEK=
KEY_NVIDIA=
KEY_GROK=

# Giới hạn & timeout
BODY_LIMIT_MB=25
RATE_LIMIT_PER_MIN=120
# Log dòng request (chỉ method/path/status/thời gian, không bao giờ log key). 0 = tắt
LOG_REQUESTS=1

# ---- Độ bền ----
# Model suy luận (thinking) cần thời gian lâu hơn trước khi trả token đầu tiên.
UPSTREAM_TIMEOUT_MS=300000
STREAM_FIRST_BYTE_TIMEOUT_MS=180000
STREAM_IDLE_TIMEOUT_MS=180000
UPSTREAM_MAX_RETRIES=2

# ---- Cooldown khi key bị từ chối (v0.3.0: ngắn hơn, có trần cứng) ----
# 429 kiểu "gửi quá nhanh" (giới hạn theo phút) — chỉ nghỉ ngắn.
KEY_COOLDOWN_MS=20000
# Key sai/bị thu hồi — nghỉ lâu.
INVALID_KEY_COOLDOWN_MS=600000
# Hết hạn mức theo ngày / hết credit — nghỉ lâu, NHƯNG chỉ với đúng model đó.
QUOTA_COOLDOWN_MS=900000
# TRẦN cứng cho mọi cooldown (tránh tình trạng "chờ 1781s" không lối thoát).
MAX_COOLDOWN_MS=1800000

# ---- MODEL FAILOVER (mới ở v0.3.0 — chính là phần sửa lỗi 402/429/503) ----
# 1 = khi model đang dùng bị hết hạn mức (429), quá tải (503), đã bị gỡ (404)
#     hoặc hết credit (402), proxy TỰ ĐỔI sang model dự phòng cùng provider
#     ngay trong request đó. App nhận kết quả bình thường, không đứt pipeline.
MODEL_FAILOVER=1
# Số model dự phòng tối đa được thử trong 1 request.
FAILOVER_MAX_MODELS=3
# 1 = khi gặp lỗi 402 (hết credit), ưu tiên chọn model MIỄN PHÍ (pricing = 0).
# Rất hữu ích với OpenRouter chưa nạp tiền. Bấm "Tải models" trong app để proxy
# biết danh sách model free THẬT của tài khoản bạn.
PREFER_FREE_ON_PAYMENT=1

# (Tùy chọn) Ép thứ tự model dự phòng cho từng provider, cách nhau bằng dấu phẩy.
# Bỏ trống = dùng thứ tự mặc định trong server/providers.js.
# FAILOVER_GEMINI=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# FAILOVER_OPENROUTER=deepseek/deepseek-chat-v3-0324:free,meta-llama/llama-3.3-70b-instruct:free
# FAILOVER_DEEPSEEK=deepseek-flash
# FAILOVER_MISTRAL=mistral-small-latest
# FAILOVER_NVIDIA=meta/llama-3.3-70b-instruct
# FAILOVER_GROK=grok-4.7

# 1 = tự dùng model thay thế chính thức khi model cũ đã bị gỡ; 0 = tắt
MODEL_AUTOFALLBACK=1
# 1 = báo lỗi nếu provider đóng luồng sớm làm câu trả lời bị cắt; 0 = bỏ qua
STRICT_STREAM_END=1

# Chống DNS-rebinding khi chạy localhost không token. Nếu truy cập bằng tên miền riêng
# (vd. qua tunnel), liệt kê tên miền đó ở ALLOWED_HOSTS (cách nhau bằng dấu phẩy) hoặc đặt STRICT_HOST_CHECK=0.
STRICT_HOST_CHECK=1
# ALLOWED_HOSTS=
# ALLOW_INSECURE_PUBLIC=0
